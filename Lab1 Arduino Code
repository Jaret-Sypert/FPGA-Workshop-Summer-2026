/*
8 LED Knight Rider
Speed controlled by 10k potentiometer
*/

const int ledPins[] = {2, 3, 4, 5, 6, 7, 8, 9};
const int numLEDs = 8;
const int potPin = A0;

void setup() {
for (int i = 0; i < numLEDs; i++) {
pinMode(ledPins[i], OUTPUT);
}
}

void loop() {

// Read potentiometer (0-1023)
int potValue = analogRead(potPin);

// Convert to delay range (20ms to 500ms)
int speedDelay = map(potValue, 0, 1023, 20, 500);

// Sweep left to right
for (int i = 0; i < numLEDs; i++) {
digitalWrite(ledPins[i], HIGH);
delay(speedDelay);
digitalWrite(ledPins[i], LOW);
}

// Sweep right to left
for (int i = numLEDs - 2; i > 0; i--) {
digitalWrite(ledPins[i], HIGH);
delay(speedDelay);
digitalWrite(ledPins[i], LOW);
}
}
